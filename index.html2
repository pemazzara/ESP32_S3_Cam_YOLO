<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Control Robot YOLO + Voz</title>
    <script src="https://cdn.jsdelivr.net/npm/onnxruntime-web/dist/ort.min.js"></script>
    <style>
        .active { background-color: #3b82f6 !important; border-color: #2563eb !important; color: white !important; }
        .mic-active { animation: pulse-red 1.5s infinite; }
        @keyframes pulse-red {
            0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            70% { box-shadow: 0 0 0 15px rgba(239, 68, 68, 0); }
            100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col items-center p-4 font-sans">

    <!-- Encabezado y Estado -->
    <div class="w-full max-w-2xl flex justify-between items-center bg-slate-800 p-4 rounded-xl shadow-lg mb-4">
        <h1 class="text-xl font-bold text-blue-400">🤖 Robot Tracker V2</h1>
        <div id="hud" class="flex gap-4 text-sm font-mono bg-slate-900 px-3 py-2 rounded-lg border border-slate-700">
            <span>🔋 --%</span>
            <span>📏 F:-- L:-- R:-- cm</span>
            <span>⚡ 0</span>
            <span id="wsStatus">🔴 WS</span>
        </div>
    </div>

    <div class="w-full max-w-2xl flex justify-between items-center mb-4 gap-4">
        <button id="btnConnect" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 rounded-lg font-bold transition-colors w-1/3">
            Conectar WS
        </button>
        <div id="lblStatus" class="flex-1 bg-slate-800 p-2 rounded-lg text-center text-sm font-mono truncate">
            Esperando conexión...
        </div>
    </div>

    <!-- Modos de Control -->
    <div class="w-full max-w-2xl flex gap-2 mb-4 bg-slate-800 p-2 rounded-xl">
        <button data-mode="manual" class="mode-btn active flex-1 py-2 bg-slate-700 border border-slate-600 rounded-lg font-bold transition-colors">🎮 Manual</button>
        <button data-mode="yolo" class="mode-btn flex-1 py-2 bg-slate-700 border border-slate-600 rounded-lg font-bold transition-colors">👁️ YOLO</button>
        <button data-mode="voice" class="mode-btn flex-1 py-2 bg-slate-700 border border-slate-600 rounded-lg font-bold transition-colors">🎤 Voz</button>
    </div>

    <!-- CONTENEDOR MODO YOLO -->
    <div id="panelYolo" class="hidden relative w-full max-w-2xl bg-black rounded-xl overflow-hidden shadow-2xl border-2 border-slate-700 aspect-video flex justify-center items-center mb-6">
        <img id="mjpegStream" src="/stream" alt="" class="hidden" crossorigin="anonymous">
        <canvas id="canvas" class="w-full h-full object-contain"></canvas>
        <div id="fps" class="absolute top-2 right-2 bg-black/70 px-2 py-1 rounded text-amber-400 font-mono text-sm">FPS: 0</div>
    </div>

    <!-- CONTENEDOR MODO VOZ -->
    <div id="panelVoice" class="hidden w-full max-w-2xl bg-slate-800 rounded-xl p-8 flex flex-col items-center justify-center mb-6 border-2 border-slate-700">
        <div id="micIcon" class="text-6xl mb-6 bg-slate-700 p-6 rounded-full transition-all">🎤</div>
        <p class="text-center text-slate-400 mb-4">Di comandos como:<br><b class="text-white">"Adelante" - "Atrás" - "Izquierda" - "Derecha" - "Para"</b></p>
        <div id="voiceLog" class="w-full bg-slate-900 p-4 rounded-lg font-mono text-center text-blue-400 min-h-[60px] flex items-center justify-center">
            Esperando comando de voz...
        </div>
    </div>

    <!-- CONTENEDOR MODO MANUAL -->
    <div id="panelManual" class="grid grid-cols-3 gap-2 w-full max-w-[250px] mb-8">
        <div></div>
        <!-- Nota: Mantengo tus ángulos manuales actualizados -->
        <button class="ctrl-btn bg-slate-700 hover:bg-slate-600 p-4 rounded-lg flex justify-center text-2xl" data-angle="90" data-speed="200" data-reverse="false">⬆️</button>
        <div></div>
        <button class="ctrl-btn bg-slate-700 hover:bg-slate-600 p-4 rounded-lg flex justify-center text-2xl" data-angle="180" data-speed="150" data-reverse="false">⬅️</button>
        <button id="btnStop" class="bg-red-600 hover:bg-red-500 p-4 rounded-lg flex justify-center font-bold text-white shadow-[0_0_15px_rgba(220,38,38,0.5)]">STOP</button>
        <button class="ctrl-btn bg-slate-700 hover:bg-slate-600 p-4 rounded-lg flex justify-center text-2xl" data-angle="0" data-speed="150" data-reverse="false">➡️</button>
        <div></div>
        <button class="ctrl-btn bg-slate-700 hover:bg-slate-600 p-4 rounded-lg flex justify-center text-2xl" data-angle="90" data-speed="200" data-reverse="true">⬇️</button>
        <div></div>
    </div>

<script>
// ==================== CONFIGURACIÓN ====================
const WS_URL = `ws://${window.location.hostname}:81`; 
const INPUT_SIZE = 640;
const CONF_THRESHOLD = 0.25;
const IOU_THRESHOLD = 0.45;
const CLASS_TARGET = 0; 

const CMD_STOP  = 0x00;
const CMD_DRIVE = 0x01;
const CMD_HEART = 0x02;

const DISTANCIA_SEGURA = 5;
const DISTANCIA_PRECAUCION = 15;


// ==================== VARIABLES GLOBALES ====================
let ws = null;
let wsConnected = false;
let session = null;
let currentMode = 'manual';
let isProcessing = false;
let fpsCounter = 0;
let lastFpsTime = performance.now();
let animationFrameId = null;
let manualInterval = null;
let heartbeatInterval = null;
let voiceRecognition = null;
// ==================== VARIABLES DE SENSORES (Añadir al inicio) ====================
// Variables globales para sensores ToF
let tofFrontal = 255;  // cm (255 = sin obstáculo)
let tofIzquierdo = 255;
let tofDerecho = 255;

// Capturamos el div de FPS correctamente
const fps = document.getElementById('fps'); 

const imgStream = document.getElementById('mjpegStream');
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
const lblStatus = document.getElementById('lblStatus');
const wsStatus = document.getElementById('wsStatus');
const resizeCanvas = document.createElement('canvas');
resizeCanvas.width = INPUT_SIZE;
resizeCanvas.height = INPUT_SIZE;
const resizeCtx = resizeCanvas.getContext('2d');

// ==================== WEBSOCKET (Core Logic) ====================
document.getElementById('btnConnect').addEventListener('click', () => {
    if (ws && wsConnected) ws.close(); else connectWebSocket();
});

function connectWebSocket() {
    lblStatus.innerText = '🔗 Conectando WebSocket...';
    try {
        ws = new WebSocket(WS_URL);
        ws.binaryType = 'arraybuffer';
        
        ws.onopen = () => {
            wsConnected = true;
            wsStatus.innerHTML = '🟢 WS';
            lblStatus.innerText = `✅ Conectado - Modo ${currentMode.toUpperCase()}`;
            if (heartbeatInterval) clearInterval(heartbeatInterval);
            heartbeatInterval = setInterval(() => {
                if (wsConnected && (currentMode === 'manual' || !isProcessing)) {
                    sendPacket(CMD_HEART, 128, 128, 90, 0, false);
                }
            }, 2000);        
        };
        
        ws.onclose = () => {
            wsConnected = false;
            wsStatus.innerHTML = '🔴 WS';
            lblStatus.innerText = '❌ Desconectado. Reconectando...';
            if (heartbeatInterval) clearInterval(heartbeatInterval);
            setTimeout(connectWebSocket, 1500);
        };
        ws.onmessage = (event) => {
            const data = new Uint8Array(event.data);
            if (data[0] === 0xBB && data[1] === 0x66) {
                updateHUD(data);
                // Supongamos que mandas los ToF en los bytes 4, 5 y 6 del paquete
                // Ver si va aca o en updateHUD, dependiendo de si quieres que se actualicen en el HUD o solo en las variables
                //tofFrontal = data[4];
                //tofDerecho = data[5];
                //tofIzquierdo = data[6];
            }
        };
        ws.onmessage = (event) => {
            const data = new Uint8Array(event.data);
            if (data[0] === 0xBB && data[1] === 0x66) updateHUD(data);
        };
    } catch (e) { lblStatus.innerText = '⚠️ Error iniciando WS.'; }
}

function updateHUD(data) {
    const bat = data[2] || 0;
    const spd = data[3] || 0;
    // Usar !== undefined para no confundir 0 con "sin dato"
    tofFrontal = data[4] !== undefined ? data[4] : 255;
    tofIzquierdo = data[5] !== undefined ? data[5] : 255;
    tofDerecho = data[6] !== undefined ? data[6] : 255;
    //tofFrontal = data[4] || 255;
    //tofIzquierdo = data[5] || 255;
    //tofDerecho = data[6] || 255;
    // Debug: ver valores reales
    console.log(`ToF: F=${tofFrontal} L=${tofIzquierdo} R=${tofDerecho}`);
    console.log(`Telemetría cruda: [${Array.from(data).join(', ')}]`);
    console.log(`ToF parseado: F=${data[4]} L=${data[5]} R=${data[6]}`);
    document.getElementById('hud').innerHTML = `
        <span>🔋 ${bat}%</span>
        <span>📏 F:${tofFrontal} L:${tofIzquierdo} R:${tofDerecho} cm</span>
        <span>⚡ ${spd}</span>
        ${wsConnected ? '<span class="text-emerald-400">🟢 WS</span>' : '<span class="text-red-400">🔴 WS</span>'}
      `;
}
// ==================== PAQUETE BINARIO ====================
function buildPacket(cmdId, xCent, yCent, angleDeg, speed, reverse = false) {
    const buf = new ArrayBuffer(12);
    const view = new DataView(buf);
    let offset = 0;
    view.setUint8(offset++, 0xAA);
    view.setUint8(offset++, 0x55);
    view.setUint8(offset++, cmdId);
    view.setUint16(offset, xCent, true); offset += 2;
    view.setUint16(offset, yCent, true); offset += 2;
    view.setInt16(offset, Math.round(angleDeg * 10), true); offset += 2;
    view.setUint8(offset++, Math.min(255, speed));
    view.setUint8(offset++, reverse ? 0x01 : 0x00);
    const payload = new Uint8Array(buf, 2, 9);
    view.setUint8(offset, crc8(payload));
    return new Uint8Array(buf);
}

function crc8(data) {
    let crc = 0x00;
    for (let i = 0; i < data.length; i++) {
        let byte = data[i];
        for (let bit = 0; bit < 8; bit++) {
            let mix = (crc ^ byte) & 0x01;
            crc >>= 1;
            if (mix) crc ^= 0x8C;
            byte >>= 1;
        }
    }
    return crc;
}
function sendPacket(cmdId, xCent, yCent, angleDeg, speed, reverse) {
    if (!ws || !wsConnected) return;
    // Para debug: mostrar qué se envía
    if (cmdId === CMD_DRIVE && speed > 0) {
        console.log(`📤 Enviando: cmd=${cmdId} centro=(${xCent},${yCent}) ang=${angleDeg} vel=${speed}`);
    }
    const packet = buildPacket(cmdId, xCent, yCent, angleDeg, speed, reverse);
    ws.send(packet.buffer);
}

function drive(angle, speed, reverse = false) { sendPacket(CMD_DRIVE, 128, 128, angle, speed, reverse); }
function stop() { sendPacket(CMD_STOP, 128, 128, 90, 0, false); }

// ==================== MODO VOZ (Speech API) ====================
function startVoiceRecognition() {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) {
        document.getElementById('voiceLog').innerHTML = "⚠️ Tu navegador no soporta reconocimiento de voz. Usa Chrome.";
        return;
    }

    if (!voiceRecognition) {
        voiceRecognition = new SpeechRecognition();
        voiceRecognition.lang = 'es-ES';
        voiceRecognition.continuous = true;
        voiceRecognition.interimResults = false;

        voiceRecognition.onstart = () => {
            document.getElementById('micIcon').classList.add('mic-active', 'bg-red-900');
            document.getElementById('voiceLog').innerText = "Escuchando... (Di 'Adelante', 'Atrás', 'Para'...)";
        };

        voiceRecognition.onresult = (event) => {
            if (currentMode !== 'voice') return;
            // Tomar la última frase dicha
            const lastResultIndex = event.results.length - 1;
            const command = event.results[lastResultIndex][0].transcript.toLowerCase().trim();
            document.getElementById('voiceLog').innerHTML = `🎙️ Comando detectado:<br><b>"${command}"</b>`;
            
            processVoiceCommand(command);
        };

        voiceRecognition.onerror = (event) => {
            console.error("Error de voz:", event.error);
            document.getElementById('micIcon').classList.remove('mic-active', 'bg-red-900');
            if(currentMode === 'voice') setTimeout(() => voiceRecognition.start(), 1000);
        };

        voiceRecognition.onend = () => {
            document.getElementById('micIcon').classList.remove('mic-active', 'bg-red-900');
            // Reiniciar automáticamente si seguimos en modo voz
            if (currentMode === 'voice') voiceRecognition.start();
        };
    }
    
    try { voiceRecognition.start(); } catch(e) {} // Evitar error si ya está corriendo
}

function stopVoiceRecognition() {
    if (voiceRecognition) {
        voiceRecognition.stop();
        document.getElementById('micIcon').classList.remove('mic-active', 'bg-red-900');
    }
}

function processVoiceCommand(cmd) {
    // Buscar palabras clave en la frase
    if (cmd.includes('adelante') || cmd.includes('avanza') || cmd.includes('vamos')) {
        drive(90, 200, false);
    } else if (cmd.includes('atrás') || cmd.includes('reversa') || cmd.includes('retrocede')) {
        drive(90, 200, true);
    } else if (cmd.includes('izquierda')) {
        drive(180, 150, false); // Asumiendo 180 es izquierda para tu hardware
    } else if (cmd.includes('derecha')) {
        drive(0, 150, false);   // Asumiendo 0 es derecha para tu hardware
    } else if (cmd.includes('para') || cmd.includes('alto') || cmd.includes('detente') || cmd.includes('stop')) {
        stop();
    }
}

// ==================== GESTIÓN DE MODOS (REEMPLAZAR) ====================
document.querySelectorAll('.mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentMode = btn.dataset.mode;
        
        // Mostrar/Ocultar Paneles
        document.getElementById('panelManual').classList.toggle('hidden', currentMode !== 'manual');
        document.getElementById('panelYolo').classList.toggle('hidden', currentMode !== 'yolo');
        document.getElementById('panelVoice').classList.toggle('hidden', currentMode !== 'voice');
        
        stop(); // Detener el robot por seguridad al cambiar de modo
        
        // --- CONTROL DEL STREAM DE LA CÁMARA ---
        if (currentMode === 'yolo') {
            // Pon aquí la IP o endpoint exacto de la cámara de tu ESP32-S3 (ej: /stream, :80/stream, etc.)
            imgStream.src = `http://${window.location.hostname}/stream`; 
            
            if (!session) {
                initYOLO();
            } else {
                startYOLOLoop();
            }
        } else {
            // Apagamos el stream si salimos de YOLO para no saturar el ESP32
            imgStream.src = ""; 
            if (animationFrameId) {
                cancelAnimationFrame(animationFrameId);
            }
        }
        
        if (currentMode === 'voice') startVoiceRecognition();
        else stopVoiceRecognition();

        lblStatus.innerText = `✅ Modo: ${currentMode.toUpperCase()}`;
    });
});
/*
// ==================== EVENTOS MANUALES ====================
document.querySelectorAll('.ctrl-btn').forEach(btn => {
    btn.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        if (currentMode !== 'manual') return;
        const angle = parseInt(btn.dataset.angle);
        const speed = parseInt(btn.dataset.speed);
        const reverse = btn.dataset.reverse === 'true';
        drive(angle, speed, reverse);
        clearInterval(manualInterval);
        manualInterval = setInterval(() => drive(angle, speed, reverse), 100);
    });
    btn.addEventListener('pointerup', (e) => { e.preventDefault(); clearInterval(manualInterval); stop(); });
    btn.addEventListener('pointerleave', () => { clearInterval(manualInterval); stop(); });
});
*/
document.getElementById('btnStop').addEventListener('click', stop);

// ==================== YOLO (Oculto en resumen) ====================
// (Aquí iría todo el código de YOLO11n que ya revisamos anteriormente)
async function initYOLO() {
    lblStatus.innerText = '⏳ Cargando YOLO11n...';
    try {
        session = await ort.InferenceSession.create('https://pemazzara.github.io/robot-models/yolo11n.onnx', { executionProviders: ['wasm'] });
        lblStatus.innerText = '📹 YOLO listo.';
        startYOLOLoop(); // (Lógica de YOLO abreviada por legibilidad)
    } catch (e) { lblStatus.innerText = '❌ Error ONNX.'; }
}

function startYOLOLoop() {
    lastFpsTime = performance.now();
    fpsCounter = 0;
    processFrame();
}

async function processFrame() {
    if (currentMode !== 'yolo') {
        animationFrameId = requestAnimationFrame(processFrame);
        return;
    }
    
    if (!isProcessing && imgStream.complete && imgStream.naturalWidth > 0) {
        isProcessing = true;
        
        const fw = imgStream.naturalWidth || 320;
        const fh = imgStream.naturalHeight || 240;
        canvas.width = fw;
        canvas.height = fh;

        // --- SOLUCIÓN DE INVERSIÓN VERTICAL EN CANVAS ---
        ctx.save();
        ctx.translate(0, fh);
        ctx.scale(1, -1); // Invierte verticalmente el renderizado para dejarlo al derecho
        ctx.drawImage(imgStream, 0, 0, fw, fh);
        ctx.restore();
        
        try {
            // El canvas ya tiene la imagen al derecho; lo enviamos a procesar
            const inputTensor = preprocessImage(canvas);
            const outputMap = await session.run({ images: inputTensor });
            const detections = processOutput(outputMap, fw, fh);                         
            console.log(`🔍 Detecciones totales: ${detections.length}`);
            // Mostrar clases detectadas
            detections.forEach(d => {
            console.log(`   Clase ${d.class}: ${(d.confidence*100).toFixed(1)}% (${d.w.toFixed(0)}x${d.h.toFixed(0)})`);
            });
            
            // Dibujamos las cajas sobre el canvas que ya está derecho
            drawDetections(detections);
            
            const target = selectTarget(detections);
            if (target) {
                sendDrivingCommand(target, fw, fh);
            } else {
                stop(); 
            }
        } catch (e) {
            // Dejamos de ser silenciosos para poder diagnosticar en la consola (F12)
            console.error("⚠️ Error en ejecución de YOLO:", e);
            lblStatus.innerText = '⚠️ Error de inferencia: ' + e.message;
        }
        
        fpsCounter++;
        const now = performance.now();
        if (now - lastFpsTime >= 1000) {
            fps.innerText = `FPS: ${fpsCounter}`;
            fpsCounter = 0;
            lastFpsTime = now;
        }
        
        isProcessing = false;
    }
    
    animationFrameId = requestAnimationFrame(processFrame);
}

function preprocessImage(sourceCanvas) {
    // 1. Redimensionar al tamaño exacto de entrada del modelo (640x640)
    //    Usamos el canvas global reutilizable (evita Garbage Collection)
    resizeCtx.drawImage(sourceCanvas, 0, 0, INPUT_SIZE, INPUT_SIZE);
    
    // 2. Extraer los píxeles RGBA del canvas redimensionado
    const imageData = resizeCtx.getImageData(0, 0, INPUT_SIZE, INPUT_SIZE);
    const data = imageData.data; // Array plano [R,G,B,A, R,G,B,A, ...]
    
    // 3. Crear el buffer para el tensor CHW float32 [1, 3, 640, 640]
    const imageSize = INPUT_SIZE * INPUT_SIZE;
    const float32Array = new Float32Array(3 * imageSize);
    
    // 4. Llenar las capas R, G, B en orden CHW, ignorando el canal Alfa
    for (let i = 0; i < imageSize; i++) {
        // data[i*4] = Rojo, data[i*4+1] = Verde, data[i*4+2] = Azul, data[i*4+3] = Alfa
        float32Array[i]                    = data[i * 4] / 255.0;     // Rojo
        float32Array[imageSize + i]        = data[i * 4 + 1] / 255.0; // Verde
        float32Array[2 * imageSize + i]    = data[i * 4 + 2] / 255.0; // Azul
    }
    
    // 5. Devolver el tensor ONNX con la forma [1, 3, 640, 640]
    return new ort.Tensor('float32', float32Array, [1, 3, INPUT_SIZE, INPUT_SIZE]);
}
// ==================== PROCESAMIENTO DE SALIDA ====================
// Solo se busca la clase objetivo (persona) y se ignoran las demás para reducir falsos positivos
// Procesa la salida del modelo y devuelve un array de detecciones con coordenadas absolutas
function processOutput(outputMap, ow, oh) {
    let output = null;
    for (const key of Object.keys(outputMap)) { output = outputMap[key]; break; }
    if (!output) return [];
    
    const data = output.data;
    const dims = output.dims;
    const numClasses = dims[1] - 4;
    const numAnchors = dims[2];
    const detections = [];
    
    for (let c = 0; c < numAnchors; c++) {
        // SOLO buscar la clase 0 (persona)
        const classIdx = 0;
        const conf = data[(4 + classIdx) * numAnchors + c];
        
        if (conf > CONF_THRESHOLD) {
            let cx = data[0 * numAnchors + c];
            let cy = data[1 * numAnchors + c];
            let w  = data[2 * numAnchors + c];
            let h  = data[3 * numAnchors + c];
            
            // Convertir coordenadas
            if (cx > 1.0 || cy > 1.0 || w > 1.0 || h > 1.0) {
                cx = (cx / INPUT_SIZE) * ow;
                cy = (cy / INPUT_SIZE) * oh;
                w  = (w  / INPUT_SIZE) * ow;
                h  = (h  / INPUT_SIZE) * oh;
            } else {
                cx = cx * ow;
                cy = cy * oh;
                w  = w  * ow;
                h  = h  * oh;
            }
            
            const x1 = cx - w / 2;
            const y1 = cy - h / 2;
            
            detections.push({
                x1, y1, x2: cx + w/2, y2: cy + h/2,
                cx, cy, w, h,
                confidence: conf,
                class: classIdx
            });
        }
    }
    
    return applyNMS(detections);
}

function applyNMS(dets) {
    dets.sort((a, b) => b.confidence - a.confidence);
    const keep = [];
    
    for (let i = 0; i < dets.length; i++) {
        let suppress = false;
        for (let j = 0; j < keep.length; j++) {
            if (dets[i].class !== keep[j].class) continue;
            const xA = Math.max(dets[i].x1, keep[j].x1);
            const yA = Math.max(dets[i].y1, keep[j].y1);
            const xB = Math.min(dets[i].x2, keep[j].x2);
            const yB = Math.min(dets[i].y2, keep[j].y2);
            const inter = Math.max(0, xB - xA) * Math.max(0, yB - yA);
            const iou = inter / (dets[i].w * dets[i].h + keep[j].w * keep[j].h - inter);
            if (iou > IOU_THRESHOLD) { suppress = true; break; }
        }
        if (!suppress) keep.push(dets[i]);
    }
    return keep;
}

function selectTarget(dets) {
    const targets = dets.filter(d => d.class === CLASS_TARGET);
    if (!targets.length) return null;
    targets.sort((a, b) => (b.w * b.h) - (a.w * a.h));
    console.log(`🎯 Buscando clase objetivo: ${CLASS_TARGET}`);
    console.log(`   Candidatos: ${targets.length}`);
    if (!targets.length) return null;
    targets.sort((a, b) => (b.w * b.h) - (a.w * a.h));
    console.log(`   Mejor: clase=${targets[0].class} conf=${(targets[0].confidence*100).toFixed(1)}%`);
    return targets[0];
}

function drawDetections(dets) {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    // Volvemos a pintar la imagen al derecho antes de poner los cuadros encima
    ctx.save();
    ctx.translate(0, canvas.height);
    ctx.scale(1, -1);
    ctx.drawImage(imgStream, 0, 0, canvas.width, canvas.height);
    ctx.restore();
    
    for (const d of dets) {
        const isTarget = d.class === CLASS_TARGET;
        ctx.strokeStyle = isTarget ? '#00ff00' : '#4488ff';
        ctx.lineWidth = isTarget ? 3 : 2;
        ctx.strokeRect(d.x1, d.y1, d.w, d.h);
        
        if (isTarget) {
            ctx.strokeStyle = '#ff0000';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(d.cx - 15, d.cy);
            ctx.lineTo(d.cx + 15, d.cy);
            ctx.moveTo(d.cx, d.cy - 15);
            ctx.lineTo(d.cx, d.cy + 15);
            ctx.stroke();
            
            ctx.fillStyle = '#00ff00';
            ctx.font = 'bold 14px monospace';
            ctx.fillText(`${(d.confidence*100).toFixed(0)}%`, d.x1, d.y1 - 6);
        }
    }
}
function sendDrivingCommand(target, fw, fh) {
    // 1. Cálculo del ángulo por visión
    const errorX = target.cx - fw / 2;
    let angleDeg = 90 - (errorX / (fw / 2)) * 45;
    angleDeg = Math.max(0, Math.min(180, angleDeg));

    // 2. Cálculo de velocidad por tamaño
    const areaRatio = (target.w * target.h) / (fw * fh);
    const AREA_FRENO = 0.6, AREA_LENTO = 0.3, AREA_MEDIO = 0.1;
    let speed;
    if (areaRatio >= AREA_FRENO) {
        speed = 0;
    } else if (areaRatio >= AREA_LENTO) {
        speed = Math.round(((AREA_FRENO - areaRatio) / (AREA_FRENO - AREA_LENTO)) * 80);
    } else if (areaRatio >= AREA_MEDIO) {
        speed = Math.round(80 + ((AREA_LENTO - areaRatio) / (AREA_LENTO - AREA_MEDIO)) * 100);
    } else {
        speed = Math.round(180 + ((AREA_MEDIO - areaRatio) / AREA_MEDIO) * 75);
        speed = Math.min(255, speed);
    }
    speed = Math.max(0, Math.min(255, speed));

    // 3. Fusión con sensores ToF

    if (tofFrontal < DISTANCIA_SEGURA) {
        speed = 0;
    } else if (tofFrontal < DISTANCIA_PRECAUCION) {
        speed = Math.round(speed * (tofFrontal - DISTANCIA_SEGURA) / (DISTANCIA_PRECAUCION - DISTANCIA_SEGURA));
    }

    if (angleDeg < 75 && tofDerecho < DISTANCIA_SEGURA) {
        angleDeg = 90;
    } else if (angleDeg > 105 && tofIzquierdo < DISTANCIA_SEGURA) {
        angleDeg = 90;
    }

    // 4. Enviar
    const xCent = Math.round((target.cx / fw) * 255);
    const yCent = Math.round((target.cy / fh) * 255);

    console.log(`🚗 Comando: area=${areaRatio.toFixed(3)} speed=${speed} angle=${angleDeg.toFixed(1)}° | ToF F:${tofFrontal} L:${tofIzquierdo} R:${tofDerecho}cm`);

    sendPacket(CMD_DRIVE, xCent, yCent, angleDeg, speed, false);
}

// ==================== INICIO ====================
window.addEventListener('load', () => {
    connectWebSocket();
    lblStatus.innerText = '🔗 Conectando al robot...';
});

window.addEventListener('beforeunload', () => {
    stop();
    clearInterval(manualInterval);
    if (animationFrameId) cancelAnimationFrame(animationFrameId);
});
</script>
</body>
</html>